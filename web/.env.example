# Stamp web app: every variable is OPTIONAL.
# With no .env at all, the app talks to the public Arc RPCs and uses the StampBox
# addresses recorded in contracts/deployments/*.json. Copy to .env.local to override.

# Which Arc network the app opens on: "mainnet" or "testnet".
# Default: mainnet if StampBox is deployed there, otherwise testnet. Users can switch in the footer.
NEXT_PUBLIC_DEFAULT_NETWORK=

# Custom RPC endpoints (e.g. Alchemy/QuickNode/dRPC) if the public ones rate-limit you.
# Defaults: https://rpc.mainnet.arc.io and https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_MAINNET_RPC=
NEXT_PUBLIC_ARC_TESTNET_RPC=

# Point the app at your own StampBox deployment (address + the block it was deployed in,
# used as the starting point for reading message logs). Defaults come from contracts/deployments/.
NEXT_PUBLIC_STAMPBOX_MAINNET=
NEXT_PUBLIC_STAMPBOX_MAINNET_START_BLOCK=
NEXT_PUBLIC_STAMPBOX_TESTNET=
NEXT_PUBLIC_STAMPBOX_TESTNET_START_BLOCK=

# The always-open demo inbox shown on the landing page ("Send me a stamp, I'll refund you").
NEXT_PUBLIC_DEMO_INBOX=

# WalletConnect Cloud project id (https://cloud.reown.com). Enables mobile wallets via QR,
# MetaMask Mobile and Rainbow. Without it, browser-extension wallets (MetaMask, Rabby, Coinbase) still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public URL of the deployed site, used for share links and social cards. Default: https://stamp-arc.vercel.app
NEXT_PUBLIC_SITE_URL=

# Source repository linked in the footer.
NEXT_PUBLIC_REPO_URL=

# ───────────────────────────── Accounts (M2) ─────────────────────────────
# Every key below is optional; a missing key hides the feature instead of crashing.

# Privy (https://dashboard.privy.io): sign-in with X, Discord, Google, email OTP, passkeys and external wallets.
# Without NEXT_PUBLIC_PRIVY_APP_ID the app falls back to browser-extension wallets only.
# In the dashboard: enable those login methods, enable "Identity tokens" (Login methods > Advanced), and add
# http://localhost:3000 (and later your domain) to Allowed origins. For X and Discord, switch on "Use your own
# credentials" and register https://auth.privy.io/api/v1/oauth/callback as the redirect URI in your X and Discord apps.
NEXT_PUBLIC_PRIVY_APP_ID=
# Configuration > App settings > Verification key (PEM). Used to verify tokens locally on every API call.
PRIVY_VERIFICATION_KEY=
# Only used to also delete the Privy user when someone deletes their Stamp account.
PRIVY_APP_SECRET=

# 32+ random characters. Signs the HttpOnly session cookie and handle-claim challenges.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=

# Postgres for profiles and handles. Neon: postgres://user:pass@host/db?sslmode=require, then `pnpm db:migrate`.
# Local alternative with nothing to install: pglite:./.data/pglite (in-process Postgres, migrated automatically).
DATABASE_URL=

# Upstash Redis for API rate limits (https://console.upstash.com). Off when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
