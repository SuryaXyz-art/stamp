# ─────────────────────────────────────────────────────────────────────────────
# Stamp launch settings: the ONE file you fill in.
#   1. Copy this file to `.env` in the repo root (same folder as this file).
#   2. Paste your keys below. Leave a line empty to skip that feature.
#   3. Run `pnpm launch check`. It tells you what's ready and what's missing.
# `.env` is gitignored and never committed or pushed.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Contract deploy on Arc mainnet (required for the grant) ────────────────
# Private key of a FRESH wallet used only to deploy. Fund it with ~$1 of USDC on Arc mainnet
# (USDC is Arc's gas token; the deploy costs a few cents). It owns nothing afterwards: StampBox has no owner.
DEPLOYER_PRIVATE_KEY=

# Recommended: a provider RPC for Arc mainnet (Alchemy, QuickNode, dRPC…). The public RPC rate-limits.
NEXT_PUBLIC_ARC_MAINNET_RPC=

# ── 2. Circle Developer Console (console.circle.com) ──────────────────────────
# Keys → Create a key → "Standard key", MAINNET (it starts with LIVE_API_KEY:). Used to register StampBox in
# Circle Contracts, create event monitors, and verify Circle's signed webhooks.
CIRCLE_API_KEY=

# ── 3. Public URL of the deployed site (after you import the repo in Vercel) ──
# e.g. https://stamp-arc.vercel.app. Needed for share links, OG cards, badges and the Circle webhook.
NEXT_PUBLIC_SITE_URL=

# Your mainnet inbox address, shown on the landing page as "Send me a stamp, I'll refund you".
NEXT_PUBLIC_DEMO_INBOX=

# ── 4. GitHub (optional: lets `pnpm launch publish` create the public repo and push) ──
# github.com/settings/personal-access-tokens → Fine-grained → "All repositories" (or create the repo first and pick it)
# → Repository permissions: Administration = Read and write (to create it), Contents = Read and write.
GITHUB_TOKEN=
# Repository name to create or push to, under your account.
GITHUB_REPO=stamp

# ── 5. Accounts: social sign-in, handles, settings (optional but recommended) ──
# dashboard.privy.io → your app. Add your Vercel domain and http://localhost:3000 to Allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=
# Configuration → App settings → Verification key (paste the PEM; newlines may be written as \n)
PRIVY_VERIFICATION_KEY=
PRIVY_APP_SECRET=
# Neon (neon.tech) connection string: postgres://user:pass@host/db?sslmode=require
# Also stores Circle webhook events for the "Latest on Arc" feed.
DATABASE_URL=
# Leave empty and `pnpm launch env` generates one for you.
SESSION_SECRET=

# ── 6. Rate limits in production (optional) ───────────────────────────────────
# console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
