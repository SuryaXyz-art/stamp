# Contracts: nothing here is needed to build or test (`forge test` runs fully offline).
#
# Deploying never reads a private key from this file. Use an encrypted Foundry keystore instead:
#   cast wallet import stamp-deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url arc_testnet --account stamp-deployer --broadcast
#
# RPC aliases `arc_mainnet` / `arc_testnet` are defined in foundry.toml. Override them here if you
# use a private endpoint, then pass e.g. --rpc-url $ARC_TESTNET_RPC.
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC=https://rpc.testnet.arc.io

# Arc's explorers run Blockscout, which needs no API key for verification.
